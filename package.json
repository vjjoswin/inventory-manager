{
  "name": "product-inventory-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && npm start",
    "start": "python3 scripts/serve.py",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "verify": "npm test && npm run check:errors && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
